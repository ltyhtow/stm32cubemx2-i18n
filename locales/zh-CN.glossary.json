{
  "locale": "zh-CN",
  "_comment": "lint 与 docs/TRANSLATION_HANDOFF.md 共用的术语表。terms：原文出现该词时译文不得用 avoid 里的写法；keep：原文里出现就必须原样保留（整词、区分大小写），与 lint 内置的硬件缩写列表合并。",
  "keep": [
    "Pack",
    "Cube"
  ],
  "terms": [
    { "en": "project", "use": "工程", "avoid": ["项目"], "note": "嵌入式领域统一叫工程" },
    { "en": "workspace", "use": "工作区", "avoid": ["工作空间"] },
    { "en": "board", "use": "开发板", "avoid": ["板子", "董事会", "木板"] },
    { "en": "middleware", "use": "中间件", "avoid": ["中间设备"] },
    { "en": "utilities", "use": "实用程序", "avoid": ["效用", "公用事业"] },
    { "en": "toolchain", "use": "工具链", "avoid": ["工具串"] },
    { "en": "peripheral", "use": "外设", "avoid": ["外围设备", "周边"] },
    { "en": "pinout", "use": "引脚配置", "avoid": ["针脚输出", "引脚引出"] },
    { "en": "pin", "use": "引脚", "avoid": ["针脚", "别针"] },
    { "en": "signal", "use": "信号", "avoid": ["讯号"] },
    { "en": "package", "use": "封装", "avoid": ["包裹"], "note": "指芯片封装（LQFP 等）时用封装；指软件包时用 Pack 原词" },
    { "en": "firmware", "use": "固件", "avoid": ["韧体"] },
    { "en": "generate code", "use": "生成代码", "avoid": ["产生代码", "生成编码"] },
    { "en": "preferences", "use": "首选项", "avoid": ["偏好设置", "偏好"] },
    { "en": "settings", "use": "设置", "avoid": ["设定"] },
    { "en": "highlight", "use": "高亮", "avoid": ["突出显示"], "note": "兼作名词与动词，「当前行突出显示」读不通" },
    { "en": "minimap", "use": "小地图", "avoid": ["缩略图"] },
    { "en": "gutter", "use": "装订线", "avoid": ["槽边距", "边槽"] },
    { "en": "selection", "use": "选区", "avoid": ["所选内容", "选择内容"] },
    { "en": "decorator", "use": "装饰器", "avoid": ["修饰器"] },
    { "en": "separator", "use": "分隔符", "avoid": ["分隔线", "分割符"] },
    { "en": "font family", "use": "字体系列", "avoid": ["字体族"] },
    { "en": "inlay hints", "use": "内联提示", "avoid": ["内嵌提示", "嵌入提示"] },
    { "en": "color picker", "use": "颜色选择器", "avoid": ["取色器"] },
    { "en": "sticky", "use": "粘性", "avoid": ["粘滞"] },
    { "en": "autoclose", "use": "自动关闭", "avoid": ["自动闭合"] },
    { "en": "wrapped lines", "use": "折行", "avoid": ["换行行"] },
    { "en": "tab completion", "use": "Tab 补全", "avoid": ["制表符补全"] },
    { "en": "breakpoint", "use": "断点", "avoid": ["中断点"] },
    { "en": "debug", "use": "调试", "avoid": ["除错"] },
    { "en": "build", "use": "构建", "avoid": ["编译"], "note": "build 是构建；compile 才是编译" },
    { "en": "compiler", "use": "编译器", "avoid": [] },
    { "en": "compile", "use": "编译", "avoid": [] },
    { "en": "flash", "use": "烧录", "avoid": ["闪存写入", "刷写"], "note": "作为动词时；作为存储器名词时保留 Flash" },
    { "en": "remove", "use": "移除", "avoid": [], "note": "remove 用移除，delete 用删除，两者要区分" },
    { "en": "delete", "use": "删除", "avoid": [] }
  ]
}
