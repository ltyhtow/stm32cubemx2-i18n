msgid "Baud rate"
msgstr "波特率"

#: pack-config/stm32c5xx_irda_parameters.json:96
#. 界面位置：pack-config/stm32c5xx_irda_parameters
#. 语境：::Device:STM32CubeMX2 Config:UART · /properties/parameters/properties/basic/properties/baud_rate/description
#, config-value
msgid ""
"This member configures the UART/IRDA communication baud rate.\n"
"      The baud rate register is computed using the following formula:\n"
"          - UART:\n"
"               Baud Rate Register = ((uart_ker_ckpres) / ((hal_uart_config_t->baud_rate)))\n"
"              ((hal_uart_config_t->baud_rate)))[15:4]\n"
"              Baud Rate Register[3] =  0\n"
"              Baud Rate Register[2:0] =  (((2 * uart_ker_ckpres) /\n"
"              ((hal_uart_config_t->baud_rate)))[3:0]) >> 1\n"
"            where uart_ker_ck_pres is the UART input clock divided by a prescaler."
msgstr ""
"此成员用于配置 UART/IRDA 通信波特率。\n"
"      波特率寄存器使用以下公式计算：\n"
"          - UART:\n"
"               Baud Rate Register = ((uart_ker_ckpres) / ((hal_uart_config_t->baud_rate)))\n"
"              ((hal_uart_config_t->baud_rate)))[15:4]\n"
"              Baud Rate Register[3] =  0\n"
"              Baud Rate Register[2:0] =  (((2 * uart_ker_ckpres) /\n"
"              ((hal_uart_config_t->baud_rate)))[3:0]) >> 1\n"
"            其中 uart_ker_ck_pres 为 UART 输入时钟经预分频器分频后的时钟。"

